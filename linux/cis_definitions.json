{
  "version": "2025-10-18",
  "rules": [
    {
      "id": "CIS-LINUX-0001",
      "description": "No shellscript in /",
      "path": "/",
      "pattern": "/*.sh",
      "action": "report"
    },
    {
      "id": "CIS-LINUX-0002",
      "description": "No executables in /var/tmp",
      "path": "/var/tmp",
      "pattern": "*.sh",
      "action": "report"
    }
  ]
}
