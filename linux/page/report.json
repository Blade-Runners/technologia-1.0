{
    "version": "2025-10-18",
    "rules": [
        { "id": "CIS-LINUX-0003", "description": "Telnet client should not be present as it transmits credentials in cleartext.", "path": "/usr/bin", "pattern": "telnet", "action": "alert", "user": "system", "timestamp": "2025-10-18T10:30:00Z" },
        { "id": "CIS-LINUX-0001", "description": "Executables should not be present in /tmp.", "path": "/tmp", "pattern": "*.sh", "action": "report", "user": "root", "timestamp": "2025-10-18T10:25:15Z" },
        { "id": "CIS-LINUX-0005", "description": "The .rhosts file allows for insecure passwordless access.", "path": "/home/guest", "pattern": ".rhosts", "action": "remediated", "user": "admin", "timestamp": "2025-10-18T09:15:45Z" },
        { "id": "CIS-LINUX-0021", "description": "X Window System server components should be removed.", "path": "/usr/bin", "pattern": "Xorg", "action": "report", "user": "system", "timestamp": "2025-10-18T09:05:10Z" },
        { "id": "CIS-LINUX-0018", "description": "prelink should be uninstalled as it modifies binaries.", "path": "/usr/sbin", "pattern": "prelink", "action": "alert", "user": "system", "timestamp": "2025-10-17T18:00:22Z" },
        { "id": "CIS-LINUX-0026", "description": "The 'at' command should be restricted. Use cron for job scheduling.", "path": "/usr/bin", "pattern": "at", "action": "remediated", "user": "admin", "timestamp": "2025-10-17T15:20:05Z" }
    ]
}
